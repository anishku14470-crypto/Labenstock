# ==============================================================================
# LABENSTOCK — Environment Variables Configuration
# Copy this file to .env.local to configure your local or production environment.
# Note: If Supabase or Razorpay credentials are left blank, LABENSTOCK will
# automatically operate in Safe Local Development Mode using persistent in-memory
# and mock storage so all features can be tested immediately.
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Configuration
# Required for production database, authentication, and image storage.
# Obtain from your Supabase Project Settings -> API.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway Configuration
# Required for real Razorpay Standard Checkout online payments.
# Obtain from your Razorpay Dashboard -> Settings -> API Keys (Use TEST mode keys first).
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# Store Operational Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STORE_NAME=LABENSTOCK
NEXT_PUBLIC_CURRENCY_SYMBOL=₹
NEXT_PUBLIC_CURRENCY_CODE=INR
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD_PAISE=300000
NEXT_PUBLIC_STANDARD_SHIPPING_FEE_PAISE=15000
